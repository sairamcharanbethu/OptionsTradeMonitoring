# Database Configuration
DATABASE_URL=postgres://user:password@cloud-db-host:5432/dbname
BACKUP_DATABASE_URL=postgres://user:password@db:5432/options_monitoring

# Docker Internal Database (Matches docker-compose.yml)
POSTGRES_DB=options_monitoring
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Market Data Providers
IBKR_HOST=ib_gateway
IBKR_PORT=4003
IBKR_CLIENT_ID_MARKET_DATA=21
IBKR_CLIENT_ID_STREAM=22
IBKR_CLIENT_ID_STRATEGY=23
IBKR_MARKET_DATA_TYPE=1
STRATEGY_REDIS_CHANNEL=strategy:state-changed
STRATEGY_FILE_POLL_INTERVAL_MS=2000
STRATEGY_REDIS_WATCHDOG_INTERVAL_MS=30000
STRIKEPILOT_CALENDAR_CONTACT=ops@example.com

# SPY signal-only-v2 strategy service
STRATEGY_IBKR_DATA_TYPE=live
STRATEGY_MAX_TOTAL_DEBIT_DOLLARS=500
STRATEGY_PREFERRED_CONTRACTS=1
STRATEGY_MAX_CONTRACTS=1
ZEROGEX_API_KEY=

# Automation & Alerts
N8N_ALERT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/alert
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-alert-webhook
MARKET_DATA_POLL_INTERVAL="*/15 * * * *"

# AI Service (Optional defaults provided in code)
OLLAMA_URL=http://host.docker.internal:11434
AI_MODEL=mistral:7b-instruct-q4_K_M

# System
PORT=3001
NODE_ENV=production
